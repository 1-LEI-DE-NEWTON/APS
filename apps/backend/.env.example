PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=aps


JWT_ACCESS_SECRET=secret

# URL do serviço de scraper (Python)
SCRAPER_API_URL=http://localhost:8000

# ===== Assistente de IA (chat do edital) =====
# Funciona com modelo LOCAL (Ollama) por padrão. Para comparar com uma LLM
# online basta trocar LLM_PROVIDER/LLM_BASE_URL/LLM_MODEL/LLM_API_KEY.
LLM_ENABLED=true
# ollama (local) | openai (qualquer API compatível com OpenAI)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=granite3-dense:2b
LLM_API_KEY=
LLM_TIMEOUT_MS=30000
LLM_TEMPERATURE=0.3

# Exemplo para usar uma LLM online (comparação):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-xxxxxxxx